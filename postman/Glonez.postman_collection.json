    {
      "name": "Staff › Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.success && res.data && res.data.token) {",
                  "  pm.environment.set('staffToken', res.data.token);",
                  "  pm.environment.set('staffRequiresPasswordChange', res.data.requiresPasswordChange);",
                  "  if (res.data.staff && res.data.staff.staffId) pm.environment.set('staffFriendlyId', res.data.staff.staffId);",
                  "  pm.test('staffToken saved', () => pm.expect(pm.environment.get('staffToken')).to.match(/^STF\\./));",
                  "} else {",
                  "  pm.test('login failed', () => pm.expect(res.success).to.equal(true));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-language", "value": "{{language}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/staff/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "staff", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            }
          }
        },
        {
          "name": "Get me",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{staffToken}}" },
              { "key": "x-language", "value": "{{language}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/staff/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "staff", "auth", "me"] }
          }
        },
        {
          "name": "Change password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{staffToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-language", "value": "{{language}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/staff/auth/change-password", "host": ["{{baseUrl}}"], "path": ["api", "staff", "auth", "change-password"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{adminPassword}}\",\n  \"newPassword\": \"NewPassw0rd!\"\n}"
            }
          }
        }
      ]
    },
