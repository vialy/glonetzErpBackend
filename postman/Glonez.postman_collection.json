    {
      "name": "User › Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.success && res.data && res.data.token) {",
                  "  pm.environment.set('userToken', res.data.token);",
                  "  pm.environment.set('userRequiresPasswordChange', res.data.requiresPasswordChange);",
                  "  if (res.data.user && res.data.user.userId) pm.environment.set('userFriendlyId', res.data.user.userId);",
                  "  pm.test('userToken saved', () => pm.expect(pm.environment.get('userToken')).to.match(/^USR\\./));",
                  "} else {",
                  "  pm.test('login failed', () => pm.expect(res.success).to.equal(true));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-language", "value": "{{language}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/users/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "users", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"emailOrPhone\": \"testuser@example.com\",\n  \"password\": \"REPLACE_WITH_TEMP_PASSWORD\"\n}"
            }
          }
        },
        {
          "name": "Change password (forced on first login)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/users/auth/change-password", "host": ["{{baseUrl}}"], "path": ["api", "users", "auth", "change-password"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"REPLACE_WITH_TEMP_PASSWORD\",\n  \"newPassword\": \"NewSecret123!\"\n}"
            }
          }
        }
